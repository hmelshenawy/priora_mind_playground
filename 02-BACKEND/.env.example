# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (Prisma) ---
DATABASE_URL=postgresql://priora:priora@localhost:5432/priora_mind?schema=public

# --- Auth / JWT (research D3) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- EmailPort (research D2) ---
# Adapter selection: "fake" (dev/test, in-memory capture) | "http" (production provider)
EMAIL_PROVIDER=fake
EMAIL_FROM=no-reply@priora.local
EMAIL_API_BASE_URL=
EMAIL_API_KEY=

# --- CORS / Frontend origin ---
CORS_ORIGIN=http://localhost:3001

# --- Internal RAG service ---
RAG_BASE_URL=http://127.0.0.1:8000
RAG_SERVICE_TOKEN=replace-with-shared-internal-token
RAG_TIMEOUT_MS=5000
RAG_SCORE_THRESHOLD=0.44

# --- LLM provider ---
# Provider: disabled | openai | ollama
LLM_PROVIDER=disabled
LLM_MODEL=your-provider-model-id
LLM_TIMEOUT_MS=60000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty when the signed-in local Ollama host proxies :cloud models.
# For direct Ollama Cloud access, set OLLAMA_BASE_URL=https://ollama.com/api
# and provide an Ollama API key here.
OLLAMA_API_KEY=

# --- OpenTelemetry (optional, redacted — no sensitive content emitted) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=priora-mind-backend
